#!/usr/bin/env bash
# Rebuild a resume PDF whenever its HTML is in the commit, and add the fresh PDF to
# that same commit. Renders the *staged* HTML, not the working copy, so a partly
# staged file still gets a matching PDF.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

for NAME in Stephano-Ng-Resume-PM Stephano-Ng-Resume-PD; do
  HTML="$NAME.html"
  PDF="$NAME.pdf"
  git diff --cached --name-only --diff-filter=ACMR | grep -qx "$HTML" || continue

  git show ":$HTML" > "$tmp/$HTML"
  echo "pre-commit: $HTML changed — rebuilding $PDF"
  if ! python3 "$root/scripts/resume-pdf.py" "$tmp/$HTML"; then
    echo "pre-commit: PDF rebuild failed, commit stopped so an old PDF doesn't ship." >&2
    echo "            Fix it, or commit with --no-verify to skip." >&2
    exit 1
  fi
  git add "$root/$PDF"
done
